# ── Orchestrator MCP server configuration ───────────────────────────────────

# Base URL of the Orchestrator API (no trailing slash). Use the loopback API
# port when running the MCP on the same host, or the public panel URL.
ORCHESTRATOR_URL=http://127.0.0.1:3001

# Personal Access Token (starts with "orch_"). Create one in the panel:
#   Settings → Access tokens  (or POST /api/tokens).
# Give it to a NON-admin user if you want the MCP limited to that user's sites.
ORCHESTRATOR_TOKEN=orch_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Allow side-effectful "safe action" tools (deploy, clear cache, maintenance,
# rollback, create staging). Read-only tools are ALWAYS available.
# Set to "false" for a strictly read-only server.
MCP_ENABLE_ACTIONS=true

# Transport:
#   - unset        → stdio (for Claude Desktop / Claude Code)
#   - a port number → Streamable HTTP server on that port (for remote/team use)
# MCP_HTTP_PORT=8787

# When using HTTP transport, require this bearer token from MCP clients
# (separate from the Orchestrator PAT). Strongly recommended for remote use.
# MCP_HTTP_AUTH=choose-a-long-random-string
